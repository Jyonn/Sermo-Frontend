+export function selectionFeedback(events,coverage,value){
+ const start=Date.parse(value.start),end=Date.parse(value.end);
+ const conflict=events.some(event=>Date.parse(event.start)<end&&Date.parse(event.end)>start);
+ return conflict?{tone:'conflict',label:'与已有日程重叠'}:coverage==='complete'?{tone:'neutral',label:'待预约时间'}:{tone:'unknown',label:'忙闲未知'};
+}
